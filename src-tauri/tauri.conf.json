{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sakeenah",
  "version": "0.5.1",
  "identifier": "app.sakeenah.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "سَكينة · Sakeenah",
        "width": 1180,
        "height": 780,
        "minWidth": 880,
        "minHeight": 580,
        "center": true,
        "theme": "Light",
        "visible": false,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/mohamadtajas/sakeenah/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlBQ0I1N0ZDNzBFNTdGQjMKUldTemYrVncvRmZMbW1NU1FJWTJyeVN3Rk9oMGhCV29FT3FsT3lEZjhwa0JxUU5QSVZQZHJhdlgK"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Sakeenah",
    "category": "Music",
    "shortDescription": "Quran, adhkar, prayer times and free audio",
    "longDescription": "Sakeenah is a light Arabic app for Quran recitation, adhkar, prayer times, live radio and Creative Commons music.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Arabic", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
